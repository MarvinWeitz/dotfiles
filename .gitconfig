[init]
	defaultBranch = main
[core]
	editor = code --wait
[pull]
	rebase = true
[alias]
	publish = !git push --set-upstream origin $(git branch --show-current)
	cleanup-branches = "!f() {\n  protected=$(git config --get cleanup.protectedBranches | tr \",\" \" \");\n  current_branch=$(git symbolic-ref --short HEAD);\n  deleted_any=false;\n\n  for branch in $(git branch --format=\"%(refname:short)\"); do\n    skip=false;\n    [ \"$branch\" = \"$current_branch\" ] && skip=true;\n    for p in $protected; do\n      [ \"$branch\" = \"$p\" ] && skip=true && break;\n    done;\n    if [ \"$skip\" = true ]; then\n      continue;\n    fi\n\n    upstream=$(git for-each-ref --format=\"%(upstream:short)\" refs/heads/\"$branch\")\n    if [ -z \"$upstream\" ]; then\n      echo \"  Skipping $branch - No upstream tracking branch\"\n      continue;\n    fi\n\n    if git branch -d \"$branch\" >/dev/null 2>&1; then\n      if [ \"$deleted_any\" = false ]; then\n        echo \"Deleting branches:\";\n        deleted_any=true;\n      fi\n      echo \"  $branch - Remote: $upstream\"\n    else\n      echo \"  Not deleting $branch - Remote: $upstream (not merged or has unpushed commits)\"\n    fi\n  done\n\n  if [ \"$deleted_any\" = false ]; then\n    echo \"No branches to delete.\"\n  fi\n}; f"
	unadd = restore -S
	close-ticket = "!f() { message=\"\"; auto_complete=\"\"; while [ $# -gt 0 ]; do case \"$1\" in -m) if [ -z \"$2\" ]; then echo \"Error: -m requires a message\" >&2; return 1; fi; message=\"$2\"; shift 2 ;; --auto-complete) auto_complete=\"--auto-complete true --delete-source-branch true\"; shift ;; *) echo \"Error: Unknown parameter '$1'. Usage: git close-ticket [--auto-complete] [-m <message>]\" >&2; return 1 ;; esac; done; current_branch=$(git branch --show-current); case \"$current_branch\" in */*) prefix=\"${current_branch%%/*}\"; ticketRef=\"${current_branch#*/}\" ;; *) echo \"Error: Branch name must contain a prefix (e.g., feature/ABC-123)\" >&2; return 1 ;; esac; git push || return 1; default_branch=$(git default-branch); commit_count=$(git rev-list --count $default_branch..$current_branch 2>/dev/null || echo \"0\"); if [ \"$commit_count\" -eq 1 ]; then if [ -z \"$message\" ]; then message=$(git log -1 --pretty=%s); fi; elif [ \"$commit_count\" -gt 1 ]; then if [ -z \"$message\" ]; then echo \"Error: Multiple commits found. Please provide a message with -m <message>\" >&2; return 1; fi; else echo \"Error: No commits found on this branch\" >&2; return 1; fi; first_char=$(printf '%s' \"$prefix\" | cut -c1 | tr '[:lower:]' '[:upper:]'); rest_chars=$(printf '%s' \"$prefix\" | cut -c2-); prefix_cap=\"$first_char$rest_chars\"; pr_title=\"$prefix_cap $ticketRef: $message\"; echo \"Creating PR: $pr_title\"; pr_id=$(az repos pr create --title \"$pr_title\" --target-branch \"$default_branch\" --source-branch \"$current_branch\" $auto_complete -o tsv --query \"pullRequestId\") || return 1; remote_url=$(git config --get remote.origin.url | sed 's|https://[^@]*@|https://|'); base_url=$(echo \"$remote_url\" | sed 's|\\.git$||'); pr_url=\"${base_url}/pullrequest/${pr_id}\"; echo \"PR created: $pr_url\"; git switch $(git default-branch) && git pull && git cleanup-branches; }; f"
	open-ticket = "!f() { if [ -z \"$1\" ]; then echo \"Error: Please provide a ticket name. Usage: git open-ticket [prefix] <ticketRef>\" >&2; return 1; fi; if [ -n \"$2\" ]; then prefix=\"$1/\"; ticket=\"$2\"; else prefix=\"feature/\"; ticket=\"$1\"; fi; case \"$ticket\" in */*) echo \"Error: Ticket name cannot contain '/'. Use separate prefix parameter instead. Example: git open-ticket feature ABC-123\" >&2; return 1 ;; esac; stashed=false; if ! git diff-index --quiet HEAD -- 2>/dev/null; then echo 'Stashing...'; git stash >/dev/null 2>&1 && stashed=true; fi; if ! git switch $(git default-branch); then [ \"$stashed\" = true ] && echo 'Reverting stash...' && git stash pop >/dev/null 2>&1; return 1; fi; if ! git pull; then [ \"$stashed\" = true ] && echo 'Reverting stash...' && git stash pop >/dev/null 2>&1; return 1; fi; if ! git switch -c \"$prefix$ticket\"; then [ \"$stashed\" = true ] && echo 'Reverting stash...' && git stash pop >/dev/null 2>&1; return 1; fi; if [ \"$stashed\" = true ]; then echo 'Restoring stash...'; git stash pop >/dev/null 2>&1; fi; }; f"
	default-branch = "!f() { \n  if ! az extension list --query \"[?name=='azure-devops'].name\" -o tsv 2>/dev/null | grep -q 'azure-devops'; then \n    echo \"Error: azure-devops extension is not installed. Install it with: az extension add --name azure-devops\" >&2; \n    return 1; \n  fi; \n  if ! az account show >/dev/null 2>&1; then \n    echo \"Error: Not logged in to Azure. Login with: az login --allow-no-subscriptions\" >&2; \n    return 1; \n  fi; \n  repoName=$(basename -s .git \"$(git config --get remote.origin.url)\"); \n  remoteBranch=$(az repos show --query defaultBranch -o tsv -r \"$repoName\"); \n  localBranch=$(git rev-parse --abbrev-ref \"$remoteBranch\"); \n  echo \"$localBranch\"; \n}; f"
[cleanup]
	protectedBranches = development,local
[push]
	default = upstream
	autoSetupRemote = true
[branch]
	autoSetupMerge = simple
[rerere]
	enabled = true
[credential]
	useHttpPath = true
